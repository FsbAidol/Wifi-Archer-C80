# ============================================================================
# Конфигурация Telegram-бота для TP-Link Archer C80
# Скопируйте этот файл в `.env` и заполните значения:
#   cp .env.example .env
# Файл .env НЕ должен попадать в git (уже добавлен в .gitignore).
# ============================================================================

# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAEXAMPLE_REPLACE_WITH_REAL_TOKEN

# Telegram User ID администраторов через запятую.
# Свой ID можно узнать командой /myid у бота или у @userinfobot.
# Доступ будет только у этих ID, остальные получат «Доступ запрещён».
ADMIN_IDS=111111111,222222222

# --- Роутер -----------------------------------------------------------------
# Локальный адрес веб-интерфейса роутера (обычно 192.168.0.1)
ROUTER_HOST=192.168.0.1

# Пароль администратора веб-интерфейса роутера
ROUTER_PASSWORD=your_router_admin_password

# Логин (у Archer C80 по умолчанию — admin)
ROUTER_USERNAME=admin

# Проверять SSL-сертификат. Для HTTPS с самоподписанным сертификатом — false.
ROUTER_VERIFY_SSL=true

# Таймаут одного запроса к роутеру, секунд
ROUTER_TIMEOUT=15

# Сколько секунд переиспользовать авторизованную сессию (0 = каждый раз заново)
ROUTER_SESSION_TTL=600

# --- ping -------------------------------------------------------------------
# Сколько пакетов отправлять в команде /ping
PING_COUNT=4

# --- Логирование -----------------------------------------------------------
# Уровень: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Путь к файлу лога (по умолчанию bot.log рядом с bot.py)
# LOG_FILE=/var/log/archer-c80-bot.log

# Дублировать логи в консоль: true | false
LOG_TO_CONSOLE=true
